# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ Platform Gradle Plugin 캐시 (IDE 아티팩트, 수백 MB)
.intellijPlatform/

# Kotlin
.kotlin/

# IDE 프로젝트 설정 (사람마다 다르다)
.idea/
*.iml

# macOS
.DS_Store

# 개인 환경 경로는 ~/.gradle/gradle.properties 에 둔다.
# 저장소의 gradle.properties 에는 빈 값과 설명만 있다.
local.properties

# 개인 permission·env 설정. 저장소에 올리지 않는다.
.claude/settings.local.json

# CI 시크릿에 올릴 값을 잠깐 담는 파일. 공개 저장소라 절대 올리지 않는다.
# 형식은 .env.example, 올리는 법은 `gh secret set -f .env`.
.env

# 플러그인 서명 키와 인증서. 실제 보관 위치는 저장소 밖이고
# (예: ~/.config/spreadsheet-viewer-signing/) 경로만 ~/.gradle/gradle.properties 에 적는다.
# 여기 적는 것은 그 규약을 깜빡했을 때를 위한 안전망이다 — 키를 만들기 전에 먼저 둔다.
*.pem
*.crt
*.p12
*.jks
*.key
