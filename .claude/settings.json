{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 180,
            "statusMessage": "커밋 전 lint · build · test 실행 중"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-guard.sh\"",
            "timeout": 20,
            "statusMessage": "TDD: 테스트가 먼저 있는지 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-red.sh\"",
            "timeout": 180,
            "statusMessage": "TDD: 새 테스트가 실패하는지(red) 확인 중"
          }
        ]
      }
    ]
  }
}
